{
  "Name": "placeOrderSaga",
  "Comment": "创建订单、扣库存、优惠券子流程、按实付金额选择支付或零元完成；异常逆序补偿",
  "Version": "2.0.0",
  "StartState": "CreateOrder",
  "IsRetryPersistModeUpdate": false,
  "IsCompensatePersistModeUpdate": false,
  "States": {
    "CreateOrder": {
      "Type": "ServiceTask",
      "ServiceName": "orderAction",
      "ServiceMethod": "createOrder",
      "CompensateState": "CancelOrder",
      "IsForUpdate": true,
      "IsPersist": true,
      "Input": [
        "$.[orderNo]",
        "$.[productId]",
        "$.[quantity]",
        "$.[amountCents]"
      ],
      "Catch": [
        {
          "Exceptions": [
            "java.lang.Throwable"
          ],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "DeductInventory"
    },
    "CancelOrder": {
      "Type": "ServiceTask",
      "ServiceName": "orderAction",
      "ServiceMethod": "cancelOrder",
      "Input": [
        "$.[orderNo]"
      ]
    },
    "DeductInventory": {
      "Type": "ServiceTask",
      "ServiceName": "inventoryAction",
      "ServiceMethod": "deduct",
      "CompensateState": "RestoreInventory",
      "IsForUpdate": true,
      "IsPersist": true,
      "Input": [
        "$.[orderNo]",
        "$.[productId]",
        "$.[quantity]",
        "$.[failAt]"
      ],
      "Catch": [
        {
          "Exceptions": [
            "java.lang.Throwable"
          ],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "CouponSubMachine"
    },
    "RestoreInventory": {
      "Type": "ServiceTask",
      "ServiceName": "inventoryAction",
      "ServiceMethod": "restore",
      "Input": [
        "$.[orderNo]",
        "$.[productId]",
        "$.[quantity]"
      ]
    },
    "PayOrder": {
      "Type": "ServiceTask",
      "ServiceName": "paymentAction",
      "ServiceMethod": "pay",
      "CompensateState": "RefundPayment",
      "IsForUpdate": true,
      "IsPersist": true,
      "Input": [
        "$.[orderNo]",
        "$.[payableCents]",
        "$.[failAt]"
      ],
      "Catch": [
        {
          "Exceptions": [
            "java.lang.Throwable"
          ],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "MarkOrderPaid"
    },
    "RefundPayment": {
      "Type": "ServiceTask",
      "ServiceName": "paymentAction",
      "ServiceMethod": "refund",
      "Input": [
        "$.[orderNo]",
        "$.[payableCents]"
      ]
    },
    "MarkOrderPaid": {
      "Type": "ServiceTask",
      "ServiceName": "orderAction",
      "ServiceMethod": "complete",
      "IsForUpdate": true,
      "IsPersist": true,
      "Input": [
        "$.[orderNo]",
        "$.[payableCents]",
        "$.[failAt]"
      ],
      "Catch": [
        {
          "Exceptions": [
            "java.lang.Throwable"
          ],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "Succeed",
      "CompensateState": "CancelOrder"
    },
    "CompensationTrigger": {
      "Type": "CompensationTrigger",
      "Next": "Fail"
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "Fail": {
      "Type": "Fail",
      "ErrorCode": "ORDER_SAGA_FAILED",
      "Message": "订单 Saga 执行失败，已触发逆序补偿"
    },
    "CouponSubMachine": {
      "Type": "SubStateMachine",
      "StateMachineName": "couponSaga",
      "CompensateState": "CompensateCoupon",
      "IsForUpdate": true,
      "IsPersist": true,
      "Input": [
        {
          "orderNo": "$.[orderNo]",
          "couponCode": "$.[couponCode]",
          "amountCents": "$.[amountCents]",
          "payableCents": "$.[payableCents]",
          "failAt": "$.[failAt]"
        }
      ],
      "Output": {
        "payableCents": "$.[payableCents]",
        "couponStatus": "$.[_sub_statemachine_execution_status_]"
      },
      "Catch": [
        {
          "Exceptions": [
            "java.lang.Throwable"
          ],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "CouponResultChoice"
    },
    "CompensateCoupon": {
      "Type": "CompensateSubMachine"
    },
    "PaymentChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Expression": "[payableCents] > 0",
          "Next": "PayOrder"
        },
        {
          "Expression": "[payableCents] == 0",
          "Next": "CompleteFreeOrder"
        }
      ],
      "Default": "CompensationTrigger"
    },
    "CompleteFreeOrder": {
      "Type": "ServiceTask",
      "ServiceName": "orderAction",
      "ServiceMethod": "complete",
      "IsForUpdate": true,
      "IsPersist": true,
      "Input": [
        "$.[orderNo]",
        "$.[payableCents]",
        "$.[failAt]"
      ],
      "Catch": [
        {
          "Exceptions": [
            "java.lang.Throwable"
          ],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "Succeed",
      "CompensateState": "CancelOrder"
    },
    "CouponResultChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Expression": "[couponStatus] == 'SU'",
          "Next": "PaymentChoice"
        }
      ],
      "Default": "CompensationTrigger"
    }
  }
}
